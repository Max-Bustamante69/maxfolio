{
  "rewrites": [
    {
      "source": "/((?!api/)(?!.*\\.html$).*)",
      "destination": "/"
    }
  ],
  "redirects": [
    {
      "source": "/(apple|persona|maison|tokonoma|reportaje)",
      "destination": "/plato",
      "permanent": true
    },
    {
      "source": "/(apple|persona|maison|tokonoma|reportaje)/:ruta*",
      "destination": "/plato/:ruta*",
      "permanent": true
    },
    {
      "source": "/v5/(apple|persona|maison|tokonoma|reportaje)/:ruta*",
      "destination": "/plato/:ruta*",
      "permanent": true
    },
    {
      "source": "/arcade",
      "destination": "/plato",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(gallery|v5)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
