# Web3Forms API Key
# Get yours at https://web3forms.com
VITE_WEB3FORMS_KEY=your-access-key-here

# Google PageSpeed Insights API key (optional, server-side only — no VITE_ prefix, never bundled).
# Raises api/psi.ts's quota above PSI's shared anonymous limit. Create one at
# https://console.cloud.google.com/apis/credentials, restricted to the PageSpeed Insights API only.
# See the README's note on the "Measure your store, right now" section for the full setup.
PSI_KEY=
